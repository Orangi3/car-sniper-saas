diff --git a/tests/test_provider_reservation_standalone.py b/tests/test_provider_reservation_standalone.py
new file mode 100644
index 0000000..92edab2
--- /dev/null
+++ b/tests/test_provider_reservation_standalone.py
@@ -0,0 +1,122 @@
+"""Standard-library, temporary SQLite only; no network or application imports."""
+import os
+import sys
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import db
+import provider_budget as pb
+import tempfile
+import unittest
+from unittest.mock import patch
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier
+from datetime import datetime, timezone, timedelta
+
+class ReservationTests(unittest.TestCase):
+    def setUp(self):
+        # Application fixtures reload db between tests; bind the current module.
+        global db
+        import importlib
+        db = importlib.import_module("db")
+        self.tmp = tempfile.TemporaryDirectory()
+        self.engine = patch.object(db, "IS_PG", False)
+        self.engine.start()
+        self.old_path = db.SQLITE_PATH
+        db.SQLITE_PATH = Path(self.tmp.name) / 'test.db'
+        with db.session() as c:
+            c.execute('CREATE TABLE usage_events(id INTEGER PRIMARY KEY, user_id INTEGER, kind TEXT, units INTEGER, cost_cents REAL, created_at TEXT)')
+        self.env = patch.dict(os.environ, {'MARKETCHECK_MONTHLY_CALL_BUDGET':'1'})
+        self.env.start()
+
+    def tearDown(self):
+        self.env.stop()
+        self.engine.stop()
+        db.SQLITE_PATH = self.old_path
+        self.tmp.cleanup()
+
+    def race(self, workers, allowance):
+        os.environ['MARKETCHECK_MONTHLY_CALL_BUDGET'] = str(allowance)
+        barrier = Barrier(workers)
+        def worker(_):
+            if hasattr(pb, 'reserve'):
+                barrier.wait(timeout=10)
+                return pb.reserve('marketcheck')
+            allowed = pb.remaining('marketcheck') > 0
+            barrier.wait(timeout=10)  # deterministically expose check/record window
+            if allowed:
+                pb.record('marketcheck')
+            return allowed
+        with ThreadPoolExecutor(max_workers=workers) as pool:
+            results = list(pool.map(worker, range(workers)))
+        self.assertEqual(sum(results), allowance)
+        self.assertEqual(pb.used('marketcheck'), allowance)
+
+    def test_one_remaining_two_workers(self): self.race(2, 1)
+    def test_many_workers(self): self.race(8, 3)
+    def test_zero(self): self.race(2, 0)
+    def test_exhausted(self):
+        self.assertTrue(pb.reserve('marketcheck'))
+        self.assertFalse(pb.reserve('marketcheck'))
+    def test_invalid_config(self):
+        for value in ['oops','-1','1.5','']:
+            with self.subTest(value=value), patch.dict(os.environ, {'MARKETCHECK_MONTHLY_CALL_BUDGET':value}):
+                with self.assertRaises(ValueError): pb.reserve('marketcheck')
+        self.assertEqual(pb.used('marketcheck'), 0)
+    def test_database_error(self):
+        with patch.object(db, 'session', side_effect=RuntimeError('fixture database failure')):
+            with self.assertRaises(RuntimeError): pb.reserve('marketcheck')
+    def test_failed_insert_rolls_back(self):
+        with db.session() as c:
+            c.execute("CREATE TRIGGER reject_usage BEFORE INSERT ON usage_events BEGIN SELECT RAISE(ABORT, 'fixture'); END")
+        with self.assertRaises(__import__("sqlite3").IntegrityError): pb.reserve('marketcheck')
+        self.assertEqual(pb.used('marketcheck'), 0)
+    def test_no_refund_after_transport_failure(self):
+        self.assertTrue(pb.reserve('marketcheck'))
+        # Caller fails before/during/after transport: reservation stays consumed.
+        self.assertFalse(pb.reserve('marketcheck'))
+    def test_month_rollover(self):
+        class Clock(datetime):
+            instant = datetime(2026,12,31,23,59,59,tzinfo=timezone.utc)
+            @classmethod
+            def now(cls, tz=None): return cls.instant
+        with patch.object(pb, 'datetime', Clock):
+            self.assertTrue(pb.reserve('marketcheck'))
+            Clock.instant = datetime(2027,1,1,tzinfo=timezone.utc)
+            self.assertTrue(pb.reserve('marketcheck'))
+            self.assertFalse(pb.reserve('marketcheck'))
+    def test_utc_boundary(self):
+        dt = datetime(2027,1,1,1,tzinfo=timezone(timedelta(hours=2)))
+        self.assertEqual(pb.month_start(dt), datetime(2026,12,1,tzinfo=timezone.utc))
+        self.assertEqual(pb.seconds_to_next_month(dt), 3600)
+
+    def test_commit_failure_denies_authorization(self):
+        with patch.object(db.Conn, 'commit', side_effect=RuntimeError('fixture commit failure')):
+            with self.assertRaises(RuntimeError): pb.reserve('marketcheck')
+        self.assertEqual(pb.used('marketcheck'), 0)
+
+    def test_adapter_reservation_contract(self):
+        # Execute actual adapter poll bodies with fixture dependencies, not HTTP.
+        # Full adapter imports require dependencies absent in this environment.
+        import ast
+        from types import SimpleNamespace
+        from unittest.mock import Mock
+        for source in ['marketcheck', 'marketcheck_fsbo']:
+            tree = ast.parse((Path(__file__).resolve().parents[1] / 'sources' / (source + '.py')).read_text())
+            funcs = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in ('poll', '_territory')]
+            for scenario in ['failure', 'exhausted', 'transport_failure', 'missing_key']:
+                with self.subTest(source=source, scenario=scenario):
+                    report = Mock(attempts=[{'outcome':'timeout'}])
+                    report.fetch.return_value = None
+                    health = SimpleNamespace(report=lambda _: report, RATE_LIMITED='rate_limited', HTTP_ERROR='http_error', AUTH='auth')
+                    ns = {'os':os, 'health':health, 'SOURCE_ID':source, 'MAX_PAGES':2, 'ROWS':50, 'SORT_BY':'dom', 'SORT_ORDER':'asc', 'ACTIVE_URL':'fixture', 'SEARCH_URL':'fixture'}
+                    exec(compile(ast.fix_missing_locations(ast.Module(body=[ast.ImportFrom(module='__future__', names=[ast.alias(name='annotations')], level=0)] + funcs, type_ignores=[])), '<actual adapter functions>', 'exec'), ns)
+                    with patch.dict(os.environ, {'MARKETCHECK_API_KEY': '' if scenario=='missing_key' else 'synthetic-test-key'}), patch.object(pb, 'reserve') as reserve:
+                        reserve.return_value = scenario=='transport_failure'
+                        if scenario=='failure': reserve.side_effect = RuntimeError('fixture database error')
+                        self.assertEqual(ns['poll']({}), [])
+                        self.assertEqual(report.fetch.call_count, int(scenario=='transport_failure'))
+                        self.assertEqual(reserve.call_count, int(scenario!='missing_key'))
+                        if scenario=='failure':
+                            self.assertIn('no request sent', report.record.call_args.kwargs['detail'])
+
+if __name__ == '__main__': unittest.main(verbosity=2)
