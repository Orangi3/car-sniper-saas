              datetime.now(timezone.utc).isoformat()))
+
+
+def reserve(source: str, calls: int = 1) -> bool:
+    """Commit a call reservation before transport. Never refund automatically.
+
+    SQLite serializes writers with BEGIN IMMEDIATE. PostgreSQL uses a table
+    lock (no schema change), with READ COMMITTED so a waiter reads the latest
+    committed ledger. This deliberately serializes usage_events writers too.
+    Exceptions propagate: configuration/storage/commit failure NEVER grants a call.
+    Legacy record() is accounting-only, not authorization; adapters use reserve().
+    """
+    import db as _db
+    if type(calls) is not int or calls <= 0:
+        raise ValueError("calls must be a positive integer")
+    raw = _env(source, "MONTHLY_CALL_BUDGET")
+    limit = DEFAULT_BUDGET.get(source, 1000) if raw is None else int(raw)
+    if limit < 0:
+        raise ValueError("monthly allowance must be nonnegative")
+    raw_cost = _env(source, "COST_PER_CALL_CENTS")
+    cost = DEFAULT_COST_CENTS.get(source, 0.0) if raw_cost is None else float(raw_cost)
+    if not math.isfinite(cost) or cost < 0 or not math.isfinite(calls * cost):
+        raise ValueError("cost must be finite and nonnegative")
+    with _db.session() as conn:
+        if _db.IS_PG:
+            conn.execute("SET TRANSACTION ISOLATION LEVEL READ COMMITTED")
+            conn.execute("LOCK TABLE usage_events IN SHARE ROW EXCLUSIVE MODE")
+        else:
+            conn.execute("BEGIN IMMEDIATE")
+        # Sample time after acquiring the lock: a wait can cross a UTC month.
+        now = datetime.now(timezone.utc)
+        start = month_start(now)
+        end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+        used_calls = int(conn.execute(
+            "SELECT COALESCE(SUM(units), 0) FROM usage_events "
+            "WHERE user_id IS NULL AND kind = ? AND created_at >= ? AND created_at < ?",
+            (f"provider:{source}", start.isoformat(), end.isoformat())).fetchone()[0])
+        if used_calls < 0:
+            raise ValueError("invalid negative usage ledger")
+        if used_calls + calls > limit:
+            return False
+        conn.execute(
+            "INSERT INTO usage_events(user_id, kind, units, cost_cents, created_at) "
+            "VALUES (NULL, ?, ?, ?, ?)",
+            (f"provider:{source}", calls, calls * cost, now.isoformat()))
+    return True  # __exit__ has successfully committed before authorization
