diff --git a/tests/test_atomic_email_quota.py b/tests/test_atomic_email_quota.py
new file mode 100644
index 0000000..9a5f038
--- /dev/null
+++ b/tests/test_atomic_email_quota.py
@@ -0,0 +1,123 @@
+"""Synthetic contention through independent DB connections; SMTP is always fake."""
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime,timedelta,timezone
+from threading import Barrier,Event,Lock
+import json,time
+import pytest
+
+@pytest.fixture
+def quota(app,monkeypatch):
+    import auth,db,mailer,seller_listings as sl
+    # No login is tested; reuse one real hash to avoid 14 bcrypt operations.
+    password_hash=auth.hash_password('fixture-password-123')
+    monkeypatch.setattr(auth,'hash_password',lambda p:password_hash)
+    users=[auth.create_user(f'quota{i}@example.com','fixture-password-123') for i in range(14)]
+    monkeypatch.setattr(mailer,'configured',lambda:True)
+    sent=[]
+    monkeypatch.setattr(mailer,'send',lambda to,*args:sent.append(to))
+    monkeypatch.setenv('SNIPER_SELLER_SUBMISSIONS','1')
+    fixed=datetime(2030,1,1,12,tzinfo=timezone.utc)
+    monkeypatch.setattr(sl,'_now',lambda:fixed)
+    return db,sl,users,sent,fixed
+
+@pytest.mark.parametrize('repeat',range(3))
+@pytest.mark.parametrize('mode,workers,cap',[
+    ('site',2,1),('site',4,2),('site',12,3),('recipient',12,3),
+    ('aliases',12,3),('last-slot',12,3)])
+def test_atomic_capacity(quota,monkeypatch,mode,workers,cap,repeat):
+    db,sl,users,sent,fixed=quota
+    monkeypatch.setattr(sl,'MAX_VERIFY_EMAILS_PER_DAY',100 if mode in ('recipient','aliases') else cap)
+    monkeypatch.setattr(sl,'MAX_SENDS_PER_RECIPIENT_PER_DAY',cap)
+    aliases=['victim@gmail.com','v.ictim+x@googlemail.com','VICTIM+tag@gmail.com']
+    for i,u in enumerate(users):
+        sl.set_contact(u,aliases[i%3] if mode=='aliases' else 'victim@example.com' if mode=='recipient' else u.email)
+    before=cap-1 if mode=='last-slot' else 0
+    for u in users[:before]:sl.send_verification(u,'https://fixture.invalid')
+    barrier=Barrier(workers);waits=[];connections=[];metrics_lock=Lock()
+    hook='_lock_email_quota' if hasattr(sl,'_lock_email_quota') else '_lock_user'
+    real=getattr(sl,hook)
+    def timed(conn,*args):
+        start=time.perf_counter();real(conn,*args)
+        # This Python lock protects only measurement collection, never capacity.
+        with metrics_lock:
+            waits.append((time.perf_counter()-start)*1000)
+            connections.append(conn.raw.get_backend_pid() if db.IS_PG else id(conn.raw))
+    monkeypatch.setattr(sl,hook,timed)
+    def send(u):
+        barrier.wait(timeout=15)
+        try:sl.send_verification(u,'https://fixture.invalid');return 200
+        except sl.SubmissionError as e:return e.status
+    with ThreadPoolExecutor(max_workers=workers) as pool:
+        results=list(pool.map(send,users[before:before+workers]))
+    successful=results.count(200)
+    print('QUOTA_METRIC '+json.dumps({'engine':'postgresql' if db.IS_PG else 'sqlite','mode':mode,'workers':workers,'cap':cap,'prefilled':before,'repeat':repeat,'successful':successful,'rejected':results.count(429),'send_attempts':len(sent),'max_reservation_wait_ms':round(max(waits),3),'distinct_connections':len(set(connections))}))
+    assert successful==cap-before
+    assert results.count(429)==workers-successful
+    assert len(sent)==cap
+    with db.session() as c:assert c.execute('SELECT COUNT(*) FROM contact_verifications').fetchone()[0]==cap
+
+def test_transaction_failure_rolls_back_then_retry_succeeds(quota,monkeypatch):
+    db,sl,users,sent,_=quota;real=sl._issue_token
+    def failure(*args):real(*args);raise RuntimeError('fixture rollback')
+    with monkeypatch.context() as m:
+        m.setattr(sl,'_issue_token',failure)
+        with pytest.raises(RuntimeError,match='fixture rollback'):sl.send_verification(users[0],'https://fixture.invalid')
+    with db.session() as c:assert c.execute('SELECT COUNT(*) FROM contact_verifications').fetchone()[0]==0
+    assert sent==[]
+    assert sl.send_verification(users[0],'https://fixture.invalid')['sent']
+
+def test_delivery_failure_releases_reservation_then_retry(quota,monkeypatch):
+    db,sl,users,sent,_=quota
+    import mailer
+    def failure(*args):raise mailer.MailerError('synthetic pre-delivery failure')
+    with monkeypatch.context() as m:
+        m.setattr(mailer,'send',failure)
+        with pytest.raises(sl.SubmissionError):sl.send_verification(users[0],'https://fixture.invalid')
+    with db.session() as c:assert c.execute('SELECT COUNT(*) FROM contact_verifications').fetchone()[0]==0
+    assert sent==[]
+    assert sl.send_verification(users[0],'https://fixture.invalid')['sent']
+
+def test_slow_smtp_does_not_hold_quota_lock(quota,monkeypatch):
+    db,sl,users,sent,_=quota
+    import mailer
+    entered=Event();release=Event()
+    def mail(to,*args):
+        sent.append(to)
+        if to==users[0].email:
+            entered.set();assert release.wait(5)
+    monkeypatch.setattr(mailer,'send',mail)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        first=pool.submit(sl.send_verification,users[0],'https://fixture.invalid')
+        assert entered.wait(5)
+        try:
+            second=pool.submit(sl.send_verification,users[1],'https://fixture.invalid')
+            assert second.result(timeout=4)['sent']
+        finally:release.set()
+        assert first.result(timeout=4)['sent']
+    assert len(sent)==2
+
+def test_rolling_window_expires_without_permanent_reservations(quota,monkeypatch):
+    db,sl,users,sent,fixed=quota
+    monkeypatch.setattr(sl,'MAX_VERIFY_EMAILS_PER_DAY',1)
+    sl.send_verification(users[0],'https://fixture.invalid')
+    with pytest.raises(sl.SubmissionError):sl.send_verification(users[1],'https://fixture.invalid')
+    monkeypatch.setattr(sl,'_now',lambda:fixed+timedelta(hours=25))
+    assert sl.send_verification(users[1],'https://fixture.invalid')['sent']
+
+def test_postgres_wait_visible_and_released_on_rollback(quota):
+    db,sl,users,sent,_=quota
+    if not db.IS_PG:pytest.skip('pg_locks observation requires actual PostgreSQL')
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        with db.session() as held:
+            sl._lock_email_quota(held)
+            future=pool.submit(sl.send_verification,users[0],'https://fixture.invalid')
+            waiting=False;until=time.monotonic()+3
+            while time.monotonic()<until:
+                with db.session() as c:
+                    waiting=bool(c.execute("SELECT COUNT(*) FROM pg_locks WHERE locktype='advisory' AND NOT granted AND classid=? AND objid=1",(0x46465645,)).fetchone()[0])
+                if waiting:break
+                time.sleep(.02)
+            assert waiting and not future.done()
+            held.rollback()
+        assert future.result(timeout=4)['sent']
+    print('PG_LOCK_OBSERVATION waiter visible; rollback released lock; one send completed')
