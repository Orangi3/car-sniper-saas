@@ -0,0 +1,36 @@
+"""SQL protocol tests only: these do not substitute for PostgreSQL execution."""
+import pytest
+
+@pytest.mark.parametrize('isolation',['repeatable read','serializable'])
+def test_snapshot_isolation_fails_closed(app,monkeypatch,isolation):
+    import db,seller_listings as sl
+    monkeypatch.setattr(db,'IS_PG',True)
+    class Conn:
+        def execute(self,sql,params=()):
+            assert 'current_setting' in sql
+            return self
+        def fetchone(self):return (isolation,)
+    with pytest.raises(sl.SubmissionError) as error:sl._lock_email_quota(Conn())
+    assert error.value.status==503
+
+def test_postgres_lock_is_transaction_scoped_and_bounded(app,monkeypatch):
+    import db,seller_listings as sl
+    monkeypatch.setattr(db,'IS_PG',True)
+    calls=[]
+    class Conn:
+        def execute(self,sql,params=()):calls.append((sql,params));return self
+        def fetchone(self):return ('read committed',)
+    sl._lock_email_quota(Conn())
+    assert 'current_setting' in calls[0][0]
+    assert "SET LOCAL lock_timeout" in calls[1][0]
+    assert 'pg_advisory_xact_lock' in calls[2][0]
+    assert calls[2][1]==(0x46465645,1)
+
+def test_sqlite_takes_write_reservation_before_reads(app,monkeypatch):
+    import db,seller_listings as sl
+    monkeypatch.setattr(db,'IS_PG',False)
+    calls=[]
+    class Conn:
+        def execute(self,sql,params=()):calls.append(sql)
+    sl._lock_email_quota(Conn())
+    assert calls==['BEGIN IMMEDIATE']
