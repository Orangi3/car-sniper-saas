+"""Independent synthetic pilot acceptance. No real mail or provider calls."""
+import pytest
+from tests.conftest import register, login, logout, set_plan
+from tests.test_matching_and_history import world, score_all
+from tests.test_seller_listings import mail, seller, car, token_from
+
+@pytest.mark.parametrize('plan,allowed', [('free',False),('starter',True),('pro',True),('',False),('invalid',False),('expired',False)])
+def test_contact_entitlement_allowlist(client, world, mail, plan, allowed):
+    seller(client, box=mail)
+    cid=client.post('/api/seller/listings',json=car()).get_json()['composite_id']
+    score_all()
+    import db, seller_listings as sl
+    with db.session() as conn:
+        result=sl.contact_for(conn,cid,plan)
+    assert result['available'] is allowed
+    if not allowed: assert 'email' not in result
+
+def test_invalid_stored_plan_cannot_read_contact_api(client,world,mail):
+    seller(client,box=mail)
+    cid=client.post('/api/seller/listings',json=car()).get_json()['composite_id']
+    score_all(); logout(client); register(client,'invalid-buyer@example.com')
+    import db
+    with db.session() as conn:
+        conn.execute("UPDATE users SET plan='invalid' WHERE email=?",('invalid-buyer@example.com',))
+    r=client.get(f'/api/deals/{cid}')
+    assert r.status_code==200
+    assert 'seller@example.com' not in r.get_data(as_text=True)
+
+def test_invited_seller_complete_journey(client, world, mail, monkeypatch):
+    import auth, invites
+    from config import CONFIG
+    monkeypatch.setitem(CONFIG,'commercial_mode',True)
+    monkeypatch.setattr(auth,'ALLOW_REGISTRATION',False)
+    _,token=invites.issue(1)[0]
+    body={'email':'pilot-seller@example.com','password':'pilot-pass-123','invite':token}
+    assert client.post('/api/auth/register',json=body).status_code==200
+    r=client.post('/api/seller/listings',json=car()).get_json()
+    assert r['status']=='pending'
+    assert client.post('/api/seller/contact',json={}).status_code==200
+    assert client.post('/api/seller/contact/verify',json={'token':token_from(mail)}).status_code==200
+    score_all()
+    sid,cid=r['id'],r['composite_id']
+    assert client.patch(f'/api/seller/listings/{sid}',json={'price':6500}).status_code==200
+    logout(client)
+    _,invite=invites.issue(1)[0]
+    assert client.post('/api/auth/register',json={'email':'pilot-buyer@example.com','password':'pilot-pass-123','invite':invite}).status_code==200
+    assert client.get(f'/api/deals/{cid}').get_json()['seller_contact']['available'] is False
+    set_plan('pilot-buyer@example.com','starter')
+    assert client.get(f'/api/deals/{cid}').get_json()['seller_contact']['email']=='pilot-seller@example.com'
+    assert client.delete(f'/api/seller/listings/{sid}').status_code==404
+    logout(client)
+    assert client.post('/api/auth/login',json={'email':'pilot-seller@example.com','password':'pilot-pass-123'}).status_code==200
+    assert client.delete(f'/api/seller/listings/{sid}').status_code==200
+    assert client.get(f'/api/deals/{cid}').status_code==404
+
+def test_email_failure_does_not_leak_synthetic_secret(client,world,mail,monkeypatch):
+    import mailer
+    register(client,'outage@example.com')
+    def fail(*a,**kw): raise mailer.MailerError('SYNTHETIC_PASSWORD=not-a-real-secret postgresql://fixture:fake@private.invalid/db')
+    monkeypatch.setattr(mailer,'send',fail)
+    r=client.post('/api/seller/contact',json={})
+    assert r.status_code==503
+    assert 'SYNTHETIC_PASSWORD' not in r.get_data(as_text=True)
+    assert 'private.invalid' not in r.get_data(as_text=True)
+
+def test_concurrent_cross_account_verification_site_cap(client,world,mail,monkeypatch):
+    import auth,seller_listings as sl
+    from concurrent.futures import ThreadPoolExecutor
