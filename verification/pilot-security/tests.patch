+"""Real PostgreSQL only. Fake mail, synthetic accounts, disposable test DBs."""
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime,timedelta,timezone
+from threading import Barrier
+import pytest
+from tests.test_seller_listings import mail
+
+@pytest.fixture
+def pg(app,mail,monkeypatch):
+    import db,seller_listings as sl,auth
+    if not db.IS_PG: pytest.skip('real disposable PostgreSQL required')
+    fixed=datetime(2030,1,1,12,tzinfo=timezone.utc)
+    monkeypatch.setattr(sl,'_now',lambda:fixed)
+    monkeypatch.setattr(sl,'MAX_SENDS_PER_RECIPIENT_PER_DAY',3)
+    monkeypatch.setattr(sl,'MAX_VERIFY_EMAILS_PER_DAY',3)
+    users=[auth.create_user(f'pg-accept{i}@example.com','synthetic-pass-123') for i in range(8)]
+    return db,sl,users,mail,fixed
+
+def asks(sl,users):
+    barrier=Barrier(len(users))
+    def send(u):
+        barrier.wait(timeout=15)
+        try: sl.send_verification(u,'https://pilot.example.invalid');return 200
+        except sl.SubmissionError as e:return e.status
+    with ThreadPoolExecutor(max_workers=len(users)) as pool:
+        return list(pool.map(send,users))
+
+@pytest.mark.parametrize('mode',['site','recipient','aliases','last-slot'])
+def test_simultaneous_caps(pg,monkeypatch,mode):
+    db,sl,users,mail,fixed=pg
+    if mode in ('recipient','aliases'):monkeypatch.setattr(sl,'MAX_VERIFY_EMAILS_PER_DAY',50)
+    aliases=['victim@gmail.com','v.ictim+one@gmail.com','VICTIM+two@googlemail.com']
+    for i,u in enumerate(users):
+        address=aliases[i%3] if mode=='aliases' else ('victim@example.com' if mode=='recipient' else u.email)
+        sl.set_contact(u,address)
+    if mode=='last-slot':
+        for u in users[:2]:sl.send_verification(u,'https://pilot.example.invalid')
+        results=asks(sl,users[2:]);assert results.count(200)==1
+    else:
+        results=asks(sl,users);assert results.count(200)==3
+    assert all(r in (200,429) for r in results)
+    assert len(mail)==3
+    with db.session() as c:assert c.execute('SELECT COUNT(*) FROM contact_verifications').fetchone()[0]==3
+
+def test_token_transaction_rollback(pg,monkeypatch):
+    db,sl,users,mail,_=pg
+    real=sl._issue_token
+    def broken(*args):real(*args);raise RuntimeError('synthetic transaction interruption')
+    with monkeypatch.context() as m:
+        m.setattr(sl,'_issue_token',broken)
+        with pytest.raises(RuntimeError,match='synthetic'):
+            sl.send_verification(users[0],'https://pilot.example.invalid')
+    with db.session() as c:assert c.execute('SELECT COUNT(*) FROM contact_verifications').fetchone()[0]==0
+    assert mail==[]
+    assert sl.send_verification(users[0],'https://pilot.example.invalid')['sent']
+
+def test_delivery_failure_releases_quota(pg,monkeypatch):
+    db,sl,users,mail,_=pg
+    import mailer
+    def fail(*args):raise mailer.MailerError('synthetic failure')
+    with monkeypatch.context() as m:
+        m.setattr(mailer,'send',fail)
+        with pytest.raises(sl.SubmissionError):sl.send_verification(users[0],'https://pilot.example.invalid')
+    with db.session() as c:assert c.execute('SELECT COUNT(*) FROM contact_verifications').fetchone()[0]==0
+    assert mail==[]
+    assert sl.send_verification(users[0],'https://pilot.example.invalid')['sent']
+
+def test_rolling_day_accounting(pg,monkeypatch):
+    db,sl,users,mail,fixed=pg
+    for u in users[:3]:sl.send_verification(u,'https://pilot.example.invalid')
+    with pytest.raises(sl.SubmissionError):sl.send_verification(users[3],'https://pilot.example.invalid')
+    monkeypatch.setattr(sl,'_now',lambda:fixed+timedelta(hours=25))
+    assert sl.send_verification(users[3],'https://pilot.example.invalid')['sent']
+    assert len(mail)==4
