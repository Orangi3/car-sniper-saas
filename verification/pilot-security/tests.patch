+import pytest
+from tests.conftest import register,login,logout,set_plan
+from tests.test_matching_and_history import world,L,make_user,score_all
+from tests.test_seller_listings import mail,seller,car
+
+@pytest.mark.parametrize('plan',[None,'',{},[]])
+def test_missing_or_malformed_contact_plan_is_denied(monkeypatch,plan):
+    import seller_listings as sl
+    monkeypatch.setattr(sl,'discoverable_ids',lambda c:{'direct:1'})
+    monkeypatch.setenv('SNIPER_SELLER_SUBMISSIONS','0')
+    assert sl.contact_for(None,'direct:1',plan)['available'] is False
+
+@pytest.fixture
+def scheduled(client,world,mail,monkeypatch):
+    seller(client,box=mail)
+    cid=client.post('/api/seller/listings',json=car()).get_json()['composite_id']
+    score_all();logout(client)
+    from tests.test_billing_lifecycle import _seed_subscription
+    _seed_subscription(client,email='scheduled@example.com',cancel_at_period_end=True)
+    import billing
+    monkeypatch.setattr(billing,'_now_utc_iso',lambda:'2030-01-01T12:00:00+00:00')
+    return cid
+
+@pytest.mark.parametrize('end,allowed',[
+    ('2030-01-01T12:00:01+00:00',True),('2030-01-01T12:00:00+00:00',False),
+    ('2030-01-01T11:59:59+00:00',False),('2030-01-01T14:00:00+02:00',False),
+    (None,False),('',False),('zzz',False),('2030-01-02',False),
+    ('2030-01-01T13:00:00',False)])
+def test_scheduled_expiry_is_strict_and_timezone_aware(client,scheduled,end,allowed):
+    import db
+    with db.session() as c:
+        c.execute('UPDATE subscriptions SET current_period_end=?',(end,))
+        c.execute("UPDATE users SET plan='starter' WHERE email='scheduled@example.com'")
+    r=client.get('/api/deals/'+scheduled)
+    assert r.status_code==200
+    assert r.get_json()['seller_contact']['available'] is allowed
+
+@pytest.mark.parametrize('path',['/api/saved','/api/me/alerts','/api/deals?feed=trusted','/api/deals?feed=search'])
+def test_legacy_inventory_read_paths(client,world,monkeypatch,path):
+    make_user(client,'reader@example.com',searches=[('camry',{'max_price':9000})],topic=False)
+    login(client,'reader@example.com')
+    world.ingest([L('legacy-secret-car',6000)]);score_all()
+    assert client.post('/api/save',json={'composite_id':'craigslist:legacy-secret-car'}).status_code==200
+    from config import CONFIG
+    monkeypatch.setitem(CONFIG,'commercial_mode',True)
+    if path.endswith('feed=search'):
+        import db
+        with db.session() as c:
+            sid=c.execute('SELECT id FROM saved_searches').fetchone()[0]
+        path+='&search_id='+str(sid)
+    r=client.get(path)
+    assert r.status_code==200
+    assert 'legacy-secret-car' not in r.get_data(as_text=True)
+
+def test_sold_comp_cache_rechecks_revoked_permission(monkeypatch):
+    import comps
+    from config import CONFIG
+    monkeypatch.setitem(CONFIG,'commercial_mode',True)
+    monkeypatch.delenv('MARKETCHECK_COMMERCIAL_AGREEMENT',raising=False)
+    monkeypatch.setattr(comps,'cached_get',lambda *a:({'marketcheck':[{'price':12345,'url':'https://private.invalid/cached'}]},1))
+    rows,_=comps.raw_sold(2015,'Toyota','Camry')
+    assert not rows.get('marketcheck')
+
+def test_saved_analysis_rechecks_licensing_preserves_user_notes(client,world,monkeypatch):
+    from tests.test_analyze import CAMRY
+    register(client,'analyst@example.com');set_plan('analyst@example.com','starter')
+    r=client.post('/api/opportunities',json={'input':CAMRY,'notes':'MY_PRIVATE_NOTE'})
+    assert r.status_code==201
+    oid=r.get_json()['id']
+    from config import CONFIG
+    monkeypatch.setitem(CONFIG,'commercial_mode',True)
+    r=client.get(f'/api/opportunities/{oid}')
+    assert r.status_code==200
+    assert 'MY_PRIVATE_NOTE' in r.get_data(as_text=True)
+    assert 'craigslist' not in r.get_data(as_text=True)
+    assert r.get_json()['value_mid'] is None
+
+def test_concurrent_expired_contact_requests(app,client,scheduled):
+    import db
+    with db.session() as c:
+        c.execute("UPDATE subscriptions SET current_period_end='2030-01-01T11:00:00+00:00'")
+    token=client.get_cookie('sniper_session').value
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+    barrier=Barrier(4)
+    def read(_):
+        c=app.test_client();c.set_cookie('sniper_session',token);barrier.wait(timeout=10)
+        r=c.get('/api/deals/'+scheduled)
+        assert r.status_code==200
+        return r.get_json()['seller_contact']['available']
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        assert list(pool.map(read,range(4)))==[False]*4
+
+def test_direct_listing_does_not_return_old_unlicensed_valuation(client,world,mail,monkeypatch):
+    seller(client,box=mail)
+    cid=client.post('/api/seller/listings',json=car()).get_json()['composite_id']
+    score_all()
+    from config import CONFIG
+    monkeypatch.setitem(CONFIG,'commercial_mode',True)
+    r=client.get('/api/deals/'+cid)
+    assert r.status_code==200
+    assert 'craigslist' not in r.get_data(as_text=True)
+    assert r.get_json()['value_mid'] is None
