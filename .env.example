# SNIPER — environment variables (example)
#
# Copy to `.env`, fill in real values, and source it before running the
# server:
#
#     cd ~/Desktop/sniper
#     set -a; source .env; set +a
#     .venv/bin/python server.py
#
# Or set them in your shell profile (~/.zshrc) so START HERE.command
# inherits them automatically.
#
# CURRENT BEHAVIOR — already wired in config.py:
#
#   config.py reads each of the variables in the FIRST block below from
#   the environment. If the env var is unset/empty, it falls back to the
#   value in overrides.json (and then to a built-in default). So setting
#   these in env is purely additive — no behavior change unless you
#   actually set them.

# --- VIN provider (NMVTIS) ---
# 'auto' tries Bumper then ClearVin; leave keys blank to skip VIN.
VIN_PROVIDER=auto
BUMPER_API_KEY=
CLEARVIN_API_KEY=

# --- Email-inbox source (optional, off unless populated) ---
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
EMAIL_IMAP_FOLDER=INBOX
# Comma-separated list of "From" addresses to ingest deal alerts from.
EMAIL_IMAP_SENDERS=


# ============================================================
# NOT YET WIRED — these are still loaded only from overrides.json.
# Migrating them to env is the next safe hardening step:
#
#   In config.py:
#       "share_password": os.environ.get("SHARE_PASSWORD",
#                                _OVERRIDES.get("share_password", "")),
#       "share_username": os.environ.get("SHARE_USERNAME",
#                                _OVERRIDES.get("share_username", "sniper")),
#       "notify_phone":   os.environ.get("NOTIFY_PHONE",
#                                _OVERRIDES.get("notify_phone", "")),
#
# After making that change, run FULL VERIFY.command to confirm
# /api/share_settings and /api/notify_settings still return 200 and
# the dashboard hero/diagnostics remain green. ONLY THEN clear the
# corresponding values from overrides.json.
# ============================================================

# --- Share access (HTTP Basic / no-login switch) ---
SHARE_USERNAME=
SHARE_PASSWORD=

# --- Phone for the Messages-based text alerts ---
NOTIFY_PHONE=


# ============================================================
# Stripe billing — TEST MODE ONLY (Phase 2A)
# ============================================================
# Use sk_test_ keys and price_… IDs from a Stripe TEST account. Never
# put live keys here. Real charges are out of scope for Phase 2A.
#
# Setup steps (see STRIPE_TESTING.md for the full walkthrough):
#   1. Stripe Dashboard (TEST mode) → Products → create "Sniper Starter"
#      and "Sniper Pro" with monthly recurring prices. Copy the price IDs.
#   2. brew install stripe/stripe-cli/stripe   (or download from stripe.com)
#      stripe login
#   3. stripe listen --forward-to localhost:8765/api/billing/webhook
#      The CLI prints a whsec_… signing secret — paste it below.
#   4. source .env && python server.py
#   5. From the dashboard, click Upgrade → Stripe Checkout (test cards work).

# Server-side secret key — sk_test_…  Used for Checkout.Session.create
# and Subscription.retrieve. NEVER commit a real key.
STRIPE_SECRET_KEY=

# Webhook signing secret — whsec_… from `stripe listen` or the Dashboard
# webhook endpoint. Verifies every inbound /api/billing/webhook request.
STRIPE_WEBHOOK_SECRET=

# Price ID allowlist (browser only sends a plan name; server maps to price).
# Get these from Stripe Dashboard → Products → your product → Pricing.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Origin used to build the Checkout success/cancel URLs. Leave blank in
# local dev to fall back to the request's Host. Set explicitly in prod
# (e.g. https://sniper.yourdomain.com) so the tunnel URL never leaks in.
BILLING_ORIGIN=
