[Unit]
Description=sniper dead-man probes (web + pipeline) → Healthchecks.io
After=network-online.target

[Service]
Type=oneshot
User=sniper
Group=sniper
EnvironmentFile=/etc/sniper/env
# Web: our own /health through Caddy (TLS + reverse proxy exercised).
# Pipeline: python -m preflight --target internal (DB, migrations,
# scheduler heartbeat, worker backlog). Each Healthchecks.io URL is pinged
# only when its check passes, so the dead-man timer fires on silence.
ExecStart=/opt/sniper/current/deploy/healthcheck.sh
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
