[Unit]
Description=sniper schema migrations (one-shot, runs before web + scheduler)
After=network-online.target postgresql.service
Requires=postgresql.service
Before=sniper-web.service sniper-scheduler.service

[Service]
Type=oneshot
# Stays active after it succeeds, so restarting web, worker or scheduler
# (each Wants= this unit) doesn't run it again. It used to: one deploy or
# rollback started it 4 times in a second, and systemd refuses a 6th start
# within 10 s, which stopped a rollback half-way. deploy/sync.sh restarts
# this unit itself on every deploy and rollback; after a restore, use
# `systemctl restart sniper-migrate` (start is a no-op while it's active).
RemainAfterExit=yes
User=sniper
Group=sniper
WorkingDirectory=/opt/sniper/current
EnvironmentFile=/etc/sniper/env
ExecStart=/opt/sniper/current/.venv/bin/python3 -m migrations.runner
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/sniper /var/log/sniper

[Install]
WantedBy=multi-user.target
