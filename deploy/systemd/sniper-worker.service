[Unit]
Description=sniper durable job worker (scoring + notifications)
After=network-online.target postgresql.service sniper-migrate.service
Requires=postgresql.service
Wants=sniper-migrate.service

[Service]
Type=simple
User=sniper
Group=sniper
WorkingDirectory=/opt/sniper/current
EnvironmentFile=/etc/sniper/env
# Any number of workers may run (claims are atomic, leases recover crashed
# jobs). Scale by raising --threads or running more instances.
ExecStart=/opt/sniper/.venv/bin/python3 -m jobs.worker --threads 4
Restart=always
RestartSec=5
# SIGTERM: finish the in-flight job, then exit. A job interrupted by a
# hard kill is reclaimed by the next worker once its lease expires.
TimeoutStopSec=150
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sniper /var/log/sniper

[Install]
WantedBy=multi-user.target
