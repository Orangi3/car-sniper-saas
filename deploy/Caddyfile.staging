# Caddyfile — staging reverse proxy
#
# Substitute __STAGING_HOSTNAME__ → your real hostname before installing,
# or let install.sh do it via `sed -i "s/__STAGING_HOSTNAME__/$HOST/g"`.
#
# Caddy fetches a Let's Encrypt certificate automatically on first
# request after the A record resolves to this host.
#
# X-Forwarded-For is SET (not appended) to the address that connected to
# Caddy, so a value a visitor sends is discarded. The app trusts it only
# because the connection comes from loopback (SNIPER_TRUSTED_PROXIES).

__STAGING_HOSTNAME__ {
    encode zstd gzip

    # Browsers stay on HTTPS (the session cookie is Secure behind this
    # proxy). No includeSubDomains/preload: those are hard to undo.
    header Strict-Transport-Security "max-age=31536000"

    # Health probe (Healthchecks.io and Stripe sanity hits) — uncached.
    @health path /health
    handle @health {
        reverse_proxy 127.0.0.1:8765 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Stripe webhook MUST never be cached or redirected; pass the raw
    # body straight through. Caddy preserves the body by default.
    @webhook path /api/billing/webhook
    handle @webhook {
        reverse_proxy 127.0.0.1:8765 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Everything else
    handle {
        reverse_proxy 127.0.0.1:8765 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {remote_host}
        }
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 10MiB
            roll_keep 7
        }
        format console
    }
}
