# ----------------------------------------------------------------------
# /etc/sniper/env — template. Owned root:sniper, mode 0600.
# Substitute values, then on the host:
#   sudo install -o root -g sniper -m 0600 /path/to/env /etc/sniper/env
# This file is the TEMPLATE — never commit the populated version.
#
# FORMAT (read by systemd EnvironmentFile=): KEY=value, one per line.
# Comments must be on their OWN line. systemd does not strip trailing
# "# ..." — `KEY=   # note` sets KEY to "# note".
#
# Defaults below are MODE A (internal staging): no public sign-up, no
# seller submissions, no real email, Stripe TEST keys only. Modes are
# switched only by editing this file and restarting (see DEPLOY.md):
#   A internal staging   ALLOW_REGISTRATION=0, SNIPER_SELLER_SUBMISSIONS=0,
#                        SMTP_* empty, Stripe sk_test_
#   B seller pilot       + SMTP_* set, SNIPER_SELLER_SUBMISSIONS=1
#                        (invited accounts only; ALLOW_REGISTRATION=0)
#   C buyer pilot        B + invited buyer accounts, alert channels set
#   D paid beta          C + Stripe LIVE keys + published terms
#                        (owner decision; not covered by this template)
# ----------------------------------------------------------------------

# --- App ---
ALLOW_REGISTRATION=0
# Invite link for pilot users: https://<host>/login#invite=<this value>.
# Generate with `openssl rand -hex 16`; change it to revoke the link.
# Empty = nobody can register (accounts only via the admin command).
SNIPER_INVITE_CODE=
# 1 vCPU / 2 GB host: 2 workers (~110 MB each measured); raise only after observing load
GUNICORN_WORKERS=2
BILLING_ORIGIN=https://staging.<your-production-domain>

# --- Database (Postgres on the same box, localhost only) ---
# Populated by install.sh — keep this format exact.
DATABASE_URL=postgresql://sniper:CHANGE_ME@127.0.0.1:5432/sniper

# --- Seller submissions (mode B+). Publishing requires working SMTP. ---
SNIPER_SELLER_SUBMISSIONS=0
# Never set on a deployed host: hand-delivered verification links are a
# dev/test tool and are refused in commercial mode anyway.
# SNIPER_ALLOW_MANUAL_VERIFY_LINKS=

# --- Transactional email (seller verification). Empty = disabled. ---
# Port 587 = STARTTLS, 465 = implicit TLS. Certificates are always
# verified; plaintext is refused for remote servers.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# e.g. Car Sniper <no-reply@your-domain>  (domain must have SPF/DKIM set up)
SMTP_FROM=
# SMTP_SSL=1 forces implicit TLS on a port other than 465
SMTP_SSL=

# --- Stripe TEST mode (NEVER sk_live_ on staging) ---
# sk_test_…
STRIPE_SECRET_KEY=
# whsec_… from the permanent dashboard endpoint
STRIPE_WEBHOOK_SECRET=
# price_… starter / pro monthly (test)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Backups: Backblaze B2 ---
# The age PRIVATE key MUST NOT live on this host — only the PUBLIC
# recipient (age1…). The host can encrypt backups but not decrypt them;
# restores happen off-host (deploy/restore.sh). A *.age.key file on this
# VPS is an incident: wipe it, rotate the keypair.
B2_BUCKET=staging-sniper
# application key id + key (write-only role scoped to the bucket)
B2_KEY_ID=
B2_APPLICATION_KEY=
# match your bucket region
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# PUBLIC age recipient (age1…) ONLY
AGE_RECIPIENT=

# --- Monitoring: Healthchecks.io ping URLs (https://hc-ping.com/<uuid>) ---
HEALTHCHECK_WEB_URL=
# scheduler + worker + DB
HEALTHCHECK_PIPELINE_URL=
HEALTHCHECK_RECONCILE_URL=
HEALTHCHECK_BACKUP_URL=

# --- Paid-product data policy (see SOURCES.md) ---
# MUST be 1 for any deployment that charges users: only licensed feeds
# run; scraped sources and personal imports are off. Also disables the
# manual seller-verification CLI.
SNIPER_COMMERCIAL_MODE=1
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production (default) or sandbox
EBAY_ENVIRONMENT=
# eBay Partner Network campaign id: links become affiliate links only if set
EBAY_EPN_CAMPAIGN_ID=
MARKETCHECK_API_KEY=

# --- Alert delivery (notifications.py). Empty = channel off. ---
# Staging (mode A) has no real users, so nothing is delivered.
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
# optional; enables Pro SMS (capped)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Plan limits / cost instrumentation ---
# e.g. {"starter":{"saved_searches":5}}
PLAN_LIMITS_JSON=
# from your invoices; shown in the ops view (/api/admin/usage, ops)
COST_SMS_CENTS=
OPS_HOSTING_MONTHLY_USD=
OPS_DATA_PLATFORM_MONTHLY_USD=

# Scheduler and worker are enabled separately:
#   systemctl enable --now sniper-worker.service sniper-scheduler.service
