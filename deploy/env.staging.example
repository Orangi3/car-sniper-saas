# ----------------------------------------------------------------------
# /etc/sniper/env  —  STAGING only.  Never use sk_live_…, real PII, or
# real customer email here.  Owned by `sniper`, mode 0600.
# ----------------------------------------------------------------------
# Substitute the placeholders below, then on the host:
#   sudo install -o sniper -g sniper -m 0600 /path/to/env /etc/sniper/env
# This file is the TEMPLATE — never commit the populated version.
# ----------------------------------------------------------------------

# --- App ---
ALLOW_REGISTRATION=0
GUNICORN_WORKERS=3                       # tune AFTER observing load
BILLING_ORIGIN=https://staging.<your-production-domain>

# --- Database (Postgres on the same box) ---
# Populated by install.sh — keep this format exact.
DATABASE_URL=postgresql://sniper:CHANGE_ME@127.0.0.1:5432/sniper

# --- Stripe TEST mode (NEVER sk_live_, NEVER real customer data) ---
STRIPE_SECRET_KEY=                       # sk_test_…
STRIPE_WEBHOOK_SECRET=                   # whsec_…  from the permanent dashboard endpoint
STRIPE_PRICE_STARTER=                    # price_…  starter monthly test
STRIPE_PRICE_PRO=                        # price_…  pro monthly test

# --- Backups: Backblaze B2 ---
# WARNING — the age PRIVATE key MUST NOT live on this host. Only the
# PUBLIC recipient string (age1…) below. The host can ENCRYPT backups
# but cannot DECRYPT them. Restores happen off-host on your Mac (or a
# dedicated recovery environment) which holds the private key. If you
# find a `*.age.key` or `*backup_age*` file on this VPS, treat it as a
# breach — wipe it, regenerate the keypair, re-encrypt next backup.
# (Do NOT write the private key to /etc/sniper/, /opt/sniper/, env files,
# logs, git, chat, screenshots, or anywhere else outside your Mac's
# encrypted keystore.)
B2_BUCKET=staging-sniper                 # bucket you create in the B2 UI
B2_KEY_ID=                               # application key id (b2_…)
B2_APPLICATION_KEY=                      # application key (write-only role)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com   # match your bucket region
AGE_RECIPIENT=                           # PUBLIC age recipient (age1…) ONLY — never the private key

# --- Monitoring: Healthchecks.io ---
HEALTHCHECK_WEB_URL=                     # https://hc-ping.com/<uuid>
HEALTHCHECK_RECONCILE_URL=               # https://hc-ping.com/<uuid>
HEALTHCHECK_BACKUP_URL=                  # https://hc-ping.com/<uuid>

# --- (Phase 2C.1) scheduler stays disabled on staging by default; ---
# --- toggle via `systemctl enable --now sniper-scheduler.service` ---
